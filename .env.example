# Server-only RR Toolbox API key (RRT-...). Read by app/api/vehicle-retention/route.ts.
# Never prefix it with NEXT_PUBLIC_ and never commit a real value.
RRTOOLBOX_API_KEY=
# Optional: RR Toolbox MCP endpoint. Defaults to https://api.rapidrecursive.com/mcp.
# Must be https (plain http is accepted only for localhost testing).
RRTOOLBOX_MCP_URL=https://api.rapidrecursive.com/mcp
